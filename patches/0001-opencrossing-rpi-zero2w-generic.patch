diff --git a/pc/include/pc_render_thread.h b/pc/include/pc_render_thread.h
new file mode 100644
index 0000000..9c76967
--- /dev/null
+++ b/pc/include/pc_render_thread.h
@@ -0,0 +1,35 @@
+#ifndef PC_RENDER_THREAD_H
+#define PC_RENDER_THREAD_H
+
+#include "types.h"
+#include "graph.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Initialize the render thread, if enabled.
+ * Must be called after SDL_GL_CreateContext and all GL init,
+ * and after releasing GL context on the main thread. */
+void pc_render_thread_init(void);
+
+/* Check if the render thread is running / active */
+int pc_render_thread_is_active(void);
+
+/* Submit a completed GRAPH display list bank to the render thread */
+void pc_render_thread_submit(GRAPH* graph, int bank_idx);
+
+/* Wait until the specified bank is finished rendering by the GPU */
+void pc_render_thread_wait_bank(int bank_idx);
+
+/* Flush: wait until all currently submitted rendering has completed */
+void pc_render_thread_flush(void);
+
+/* Stop the render thread and rejoin before GL context destruction */
+void pc_render_thread_shutdown(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PC_RENDER_THREAD_H */
