diff --git a/pc/src/pc_render_thread.c b/pc/src/pc_render_thread.c
new file mode 100644
index 0000000..d07e4c2
--- /dev/null
+++ b/pc/src/pc_render_thread.c
@@ -0,0 +1,217 @@
+#define _GNU_SOURCE
+#include "pc_render_thread.h"
+#include "pc_platform.h"
+#include <SDL.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef __linux__
+#include <sched.h>
+#include <pthread.h>
+#include <unistd.h>
+#endif
+
+extern SDL_Window* g_pc_window;
+extern SDL_GLContext g_pc_gl_context;
+extern int g_pc_running;
+
+/* Forward declare graph_task_set00 */
+extern void graph_task_set00(GRAPH* graph);
+
+static SDL_Thread* s_render_thread = NULL;
+static SDL_mutex* s_render_mutex = NULL;
+static SDL_cond* s_work_cond = NULL;
+static SDL_cond* s_done_cond = NULL;
+
+static int s_is_active = 0;
+static int s_should_exit = 0;
+
+/* Work slot */
+static GRAPH* s_pending_graph = NULL;
+static int s_pending_bank = -1;
+static int s_has_work = 0;
+
+/* Bank busy flags: 0 or 1 */
+static int s_bank_busy[2] = {0, 0};
+
+#ifdef __linux__
+static void set_core_affinity(int core_id) {
+    long nprocs = sysconf(_SC_NPROCESSORS_ONLN);
+    if (nprocs <= 1) return;
+    int target_core = core_id;
+    if (target_core >= nprocs) {
+        target_core = (int)(nprocs - 1);
+    }
+    cpu_set_t cpuset;
+    CPU_ZERO(&cpuset);
+    CPU_SET(target_core, &cpuset);
+    if (pthread_setaffinity_np(pthread_self(), sizeof(cpu_set_t), &cpuset) == 0) {
+        printf("[PC/THREAD] Successfully pinned thread to CPU core %d (system has %ld cores)\n",
+               target_core, nprocs);
+    }
+}
+#endif
+
+static int pc_render_worker(void* data) {
+    (void)data;
+    printf("[PC/RENDER] Dedicated Render Thread starting...\n");
+
+#ifdef __linux__
+    /* Pi Zero 2W: Core 3 for GPU/render thread */
+    set_core_affinity(3);
+#endif
+
+    if (SDL_GL_MakeCurrent(g_pc_window, g_pc_gl_context) != 0) {
+        fprintf(stderr, "[PC/RENDER] ERROR: SDL_GL_MakeCurrent failed on render thread: %s\n", SDL_GetError());
+        s_is_active = 0;
+        return 1;
+    }
+
+    printf("[PC/RENDER] OpenGL context successfully bound to Render Thread.\n");
+
+    SDL_LockMutex(s_render_mutex);
+    while (!s_should_exit) {
+        while (!s_has_work && !s_should_exit) {
+            SDL_CondWait(s_work_cond, s_render_mutex);
+        }
+
+        if (s_should_exit && !s_has_work) {
+            break;
+        }
+
+        GRAPH* cur_graph = s_pending_graph;
+        int cur_bank = s_pending_bank;
+        s_has_work = 0;
+        s_pending_graph = NULL;
+        s_pending_bank = -1;
+
+        /* Signal that the pending work slot is now free */
+        SDL_CondSignal(s_done_cond);
+        SDL_UnlockMutex(s_render_mutex);
+
+        /* Execute display list processing + OpenGL submission + buffer swap */
+        if (cur_graph != NULL) {
+            pc_vi_notify_frame_start();
+            graph_task_set00(cur_graph);
+        }
+
+        SDL_LockMutex(s_render_mutex);
+        if (cur_bank >= 0 && cur_bank < 2) {
+            s_bank_busy[cur_bank] = 0;
+        }
+        /* Signal that cur_bank is now free to be reused by simulation */
+        SDL_CondBroadcast(s_done_cond);
+    }
+    SDL_UnlockMutex(s_render_mutex);
+
+    /* Release context before exiting thread */
+    SDL_GL_MakeCurrent(g_pc_window, NULL);
+    printf("[PC/RENDER] Render Thread exiting cleanly.\n");
+    return 0;
+}
+
+void pc_render_thread_init(void) {
+    const char* env_decouple = getenv("PC_DECOUPLE");
+    if (env_decouple && atoi(env_decouple) == 0) {
+        printf("[PC/RENDER] Decoupled multithreading explicitly disabled via PC_DECOUPLE=0.\n");
+        s_is_active = 0;
+        return;
+    }
+
+    s_render_mutex = SDL_CreateMutex();
+    s_work_cond = SDL_CreateCond();
+    s_done_cond = SDL_CreateCond();
+    s_bank_busy[0] = 0;
+    s_bank_busy[1] = 0;
+    s_has_work = 0;
+    s_should_exit = 0;
+
+    /* Release GL context on calling (main) thread before spawning render thread */
+    if (SDL_GL_MakeCurrent(g_pc_window, NULL) != 0) {
+        fprintf(stderr, "[PC/RENDER] Warning: SDL_GL_MakeCurrent(NULL) failed on main thread: %s\n", SDL_GetError());
+    }
+
+#ifdef __linux__
+    /* Pi Zero 2W: Main logic thread pinned to Core 0 */
+    set_core_affinity(0);
+#endif
+
+    s_is_active = 1;
+    s_render_thread = SDL_CreateThread(pc_render_worker, "RenderThread", NULL);
+    if (!s_render_thread) {
+        fprintf(stderr, "[PC/RENDER] Failed to create render thread: %s. Falling back to sync.\n", SDL_GetError());
+        SDL_GL_MakeCurrent(g_pc_window, g_pc_gl_context);
+        s_is_active = 0;
+    } else {
+        printf("[PC/RENDER] Decoupled multithreading active: Core 0 (Sim) <-> Core 3 (Render)\n");
+    }
+}
+
+int pc_render_thread_is_active(void) {
+    return s_is_active;
+}
+
+void pc_render_thread_submit(GRAPH* graph, int bank_idx) {
+    if (!s_is_active) {
+        graph_task_set00(graph);
+        return;
+    }
+
+    SDL_LockMutex(s_render_mutex);
+    /* Wait if previous work has not been picked up yet */
+    while (s_has_work && !s_should_exit) {
+        SDL_CondWait(s_done_cond, s_render_mutex);
+    }
+
+    if (bank_idx >= 0 && bank_idx < 2) {
+        s_bank_busy[bank_idx] = 1;
+    }
+    s_pending_graph = graph;
+    s_pending_bank = bank_idx;
+    s_has_work = 1;
+    SDL_CondSignal(s_work_cond);
+    SDL_UnlockMutex(s_render_mutex);
+}
+
+void pc_render_thread_wait_bank(int bank_idx) {
+    if (!s_is_active) return;
+    if (bank_idx < 0 || bank_idx >= 2) return;
+
+    SDL_LockMutex(s_render_mutex);
+    while (s_bank_busy[bank_idx] && !s_should_exit) {
+        SDL_CondWait(s_done_cond, s_render_mutex);
+    }
+    SDL_UnlockMutex(s_render_mutex);
+}
+
+void pc_render_thread_flush(void) {
+    if (!s_is_active) return;
+
+    SDL_LockMutex(s_render_mutex);
+    while ((s_has_work || s_bank_busy[0] || s_bank_busy[1]) && !s_should_exit) {
+        SDL_CondWait(s_done_cond, s_render_mutex);
+    }
+    SDL_UnlockMutex(s_render_mutex);
+}
+
+void pc_render_thread_shutdown(void) {
+    if (!s_is_active || !s_render_thread) return;
+
+    SDL_LockMutex(s_render_mutex);
+    s_should_exit = 1;
+    SDL_CondSignal(s_work_cond);
+    SDL_UnlockMutex(s_render_mutex);
+
+    int status = 0;
+    SDL_WaitThread(s_render_thread, &status);
+    s_render_thread = NULL;
+    s_is_active = 0;
+
+    if (s_work_cond) { SDL_DestroyCond(s_work_cond); s_work_cond = NULL; }
+    if (s_done_cond) { SDL_DestroyCond(s_done_cond); s_done_cond = NULL; }
+    if (s_render_mutex) { SDL_DestroyMutex(s_render_mutex); s_render_mutex = NULL; }
+
+    /* Rebind GL context to main thread for cleanup */
+    SDL_GL_MakeCurrent(g_pc_window, g_pc_gl_context);
+}
