+        int row_stride = (w * 3 + 3) & ~3;
+        int img_size = row_stride * h;
+        int file_size = 54 + img_size;
+
+        u8 header[54] = {
+            'B', 'M',
+            (u8)(file_size & 0xFF), (u8)((file_size >> 8) & 0xFF), (u8)((file_size >> 16) & 0xFF), (u8)((file_size >> 24) & 0xFF),
+            0, 0, 0, 0,
+            54, 0, 0, 0,
+            40, 0, 0, 0,
+            (u8)(w & 0xFF), (u8)((w >> 8) & 0xFF), (u8)((w >> 16) & 0xFF), (u8)((w >> 24) & 0xFF),
+            (u8)(h & 0xFF), (u8)((h >> 8) & 0xFF), (u8)((h >> 16) & 0xFF), (u8)((h >> 24) & 0xFF),
